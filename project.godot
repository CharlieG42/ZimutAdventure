; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ZimutAdventure"
config/description="Aventure et exploration dans les grands espaces sauvages."
config/version="0.1.0"
run/main_scene="res://scenes/world/canyon_playground.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputManager="*res://scripts/autoload/input_manager.gd"
LocalizationLoader="*res://scripts/autoload/localization_loader.gd"
InteractionManager="*res://scripts/autoload/interaction_manager.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Sfx="*res://scripts/autoload/sfx.gd"
DayNightCycle="*res://scripts/autoload/day_night_cycle.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
CraftManager="*res://scripts/autoload/craft_manager.gd"
SurvivalManager="*res://scripts/autoload/survival_manager.gd"
Progression="*res://scripts/autoload/progression.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

