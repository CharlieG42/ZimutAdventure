# Godot 4-specific ignores
.godot/
.android/
/android/

# Imported resources (generated by the editor)
*.import

# Local export presets override (may contain local keystore passwords)
# The committed export_presets.cfg ships with an empty release password;
# CI injects it via the GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD env var.
export_presets.local.cfg

# Keystores - NEVER commit these
*.keystore
*.jks
.godot/release.keystore

# Imported translations
locales/*.translation

# OS / editor files
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Build outputs
build/
dist/
